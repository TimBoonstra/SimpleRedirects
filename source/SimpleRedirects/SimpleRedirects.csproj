<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ContentTargetFolders>.</ContentTargetFolders>
        <Product>TB.SimpleRedirects</Product>
        <PackageId>TB.SimpleRedirects</PackageId>
        <Title>TB.SimpleRedirects</Title>
        <Authors>Tim</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/TimBoonstra/SimpleRedirects</PackageProjectUrl>
        <Description>Umbraco Redirect Manager for the Umbraco Back-Office</Description>
        <PackageTags>umbraco plugin package</PackageTags>
        <PackageIconUrl>https://raw.githubusercontent.com/TimBoonstra/SimpleRedirects/v9/main/package/simpleRedirectsLogo.png</PackageIconUrl>
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleRedirects.Core\SimpleRedirects.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="build\**\*.*">
            <Pack>True</Pack>
            <PackagePath>build</PackagePath>
        </None>
    </ItemGroup>

    <!-- Build the frontend client automatically -->
    <Target Name="NpmInstall" BeforeTargets="BeforeBuild" Inputs="Client/package.json" Outputs="Client/node_modules/.package-lock.json">
        <Exec Command="npm ci --prefer-offline" WorkingDirectory="Client" />
    </Target>

    <Target Name="NpmBuild" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall" Inputs="Client/src/**/*;Client/package.json;Client/tsconfig.json;Client/vite.config.ts" Outputs="wwwroot/App_Plugins/SimpleRedirects/simple-redirects.js">
        <Exec Command="npm run build" WorkingDirectory="Client" />
    </Target>
</Project>
